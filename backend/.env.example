# Copy this to .env and fill in your values

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://instant_mechanic:instant_mechanic_dev@localhost:5433/instant_mechanic_dashboard"

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── CORS ──────────────────────────────────────────────────────────────────────
# Frontend origin — for local dev this is localhost:3000
CORS_ORIGIN=http://localhost:3000

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET=change-me-to-a-long-random-secret-before-deploying

# ── Simulator ─────────────────────────────────────────────────────────────────
# Set to "true" to disable the live booking simulator in production
DISABLE_SIMULATOR=false
