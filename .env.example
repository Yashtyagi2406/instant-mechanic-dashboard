# ═══════════════════════════════════════════════════════════════════════════════
# Instant Mechanic — Environment Variables Reference
# ═══════════════════════════════════════════════════════════════════════════════
#
# Copy relevant sections to:
#   /backend/.env          (backend service)
#   /frontend/.env.local   (Next.js frontend)
#
# Then fill in your actual values.

# ── Backend ────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://instant_mechanic:instant_mechanic_dev@localhost:5433/instant_mechanic_dashboard"
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
# Generate: openssl rand -base64 32
JWT_SECRET=change-me-to-a-long-random-secret-before-deploying
# Set to "true" in production to disable the live demo simulator
DISABLE_SIMULATOR=false

# ── Frontend (Next.js — must be prefixed NEXT_PUBLIC_) ─────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
